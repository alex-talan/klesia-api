{
  "ConnectionStrings": {
    "KlesiaDb": "Server=tcp:<your-server>.database.windows.net,1433;Database=<your-database>;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10"
  },
  "AzureAd": {
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-api-client-id>",
    "RequiredScope": "<your-delegated-scope-name>"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
