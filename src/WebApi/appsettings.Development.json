{
  "ConnectionStrings": {
    "KlesiaDb": "Server=tcp:<your-server>.database.windows.net,1433;Database=<your-database>;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-api-client-id>",
    "RequiredScope": "access_as_user"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Storage": {
    "BlobServiceUri": "https://<your-storage-account>.blob.core.windows.net",
    "ContainerName": "<your-private-container>"
  },
  "Upload": {
    "MaxPdfSizeMb": 10
  },
  "DocumentIntelligence": {
    "Endpoint": "https://<your-document-intelligence-resource>.cognitiveservices.azure.com/",
    "ModelId": "<your-bae-model-id>",
    "TimeoutSeconds": 120
  },
  "Extraction": {
    "MaxConcurrency": 2,
    "QueueCapacity": 100,
    "StaleAfterMinutes": 15,
    "SweepIntervalMinutes": 5
  },
  "AzureSignalR": {
    "Endpoint": "https://<your-signalr-resource>.service.signalr.net",
    "HubName": "demands"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
