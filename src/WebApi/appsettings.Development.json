{
  "ConnectionStrings": {
    "KlesiaDb": "Server=<your-server>.mysql.database.azure.com;Port=3306;Database=klesia;User ID=<your-entra-user-name>;SslMode=Required;ConnectionTimeout=30"
  },
  "AzureAd": {
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-api-client-id>",
    "RequiredScope": "<your-delegated-scope-name>"
  },
